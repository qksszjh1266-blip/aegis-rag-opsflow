# 仅用于本地开发；部署时由环境变量或密钥管理服务覆盖。
APP_NAME=aegis-rag-opsflow
DEBUG=false
LOG_LEVEL=INFO
MYSQL_DSN=mysql+asyncmy://aegis:aegis_pass@127.0.0.1:3306/aegis_rag
MYSQL_DATABASE=aegis_rag
MYSQL_USER=aegis
MYSQL_PASSWORD=aegis_pass
MYSQL_ROOT_PASSWORD=aegis_root_dev_pass
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
PROVIDER_MODE=mock
# 未配置独立模式时继承 PROVIDER_MODE；允许 mock、dashscope、openai。
# 仅开通对话模型时保留全局 mock，再单独开启真实千问：
# LLM_PROVIDER_MODE=dashscope
# EMBEDDING_PROVIDER_MODE=mock
# RERANK_PROVIDER_MODE=mock
# mock 使用本地确定性向量；真实向量和精排仍使用公共密钥。
# PROVIDER_API_KEY=请替换为模型服务密钥
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
# 未配置时按模式选择：dashscope 为 text-embedding-v4，openai 为 text-embedding-3-small。
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_MODEL=gte-rerank-v2
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DEPENDENCY_TIMEOUT_SECONDS=3

# 对话优先使用 LLM_API_KEY，未配置时兼容 PROVIDER_API_KEY。
# LLM_API_KEY=请替换为对话服务密钥
# 默认模型按模式选择 qwen-plus 或 gpt-4o-mini；可填写账户支持的 qwen4-max 等模型。
# LLM_MODEL=qwen-plus
# BASE_URL 填完整兼容前缀，不包含 /chat/completions；密钥、地域和套餐端点须匹配。
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Coding Plan 国内端点示例：https://coding.dashscope.aliyuncs.com/v1
# Token Plan 端点示例：https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# 套餐可用模型与适用场景以账户控制台为准；网关不绑定固定模型白名单。
# 单次生成超时范围 (0,120] 秒；真实工作流按最多四次调用自动扩大预算和会话锁租期。
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
# REST 与 MCP 共用 Bearer 密钥映射，只信任此映射或认证适配器提供的访问上下文。
# Dify 可访问的网关外部地址，用于 OpenAPI servers 及 MCP 允许主机校验。
# 反向代理使用路径前缀时，此处包含前缀，同时配置 ASGI root_path。
PUBLIC_BASE_URL=http://localhost:8000
# 调用方不能通过请求正文或权限请求头自行提高角色；默认空映射拒绝未认证调用。
# 请用密钥管理服务注入 JSON，不要提交真实密钥到仓库。
# GATEWAY_API_TOKENS={"请替换为随机强密钥":{"subject_id":"dify-service","dept_scope":["warehouse","customer_service"],"role_level":1}}
# JSON 数组可增加自定义红线词；内置五个红线词无法移除。
HIGH_RISK_KEYWORDS=["漏电","冒烟","起火","批量资损","监管投诉"]
